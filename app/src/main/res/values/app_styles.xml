<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         基于原 APK 的深色配色重建的主题。
         说明：原 APK 资源被混淆，不少自定义属性名与新版 Material 库属性
         （如 colorOnPrimary、colorSurface）冲突，在 AGP 下会被本工程的
         属性表覆盖，导致主题里这些值失效。因此这里全部改用标准属性名。
         ============================================================ -->

    <style name="LedButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">@font/rubik_medium</item>
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LedSlider" parent="Widget.MaterialComponents.Slider">
        <item name="thumbColor">@color/text_primary</item>
        <item name="thumbRadius">12dp</item>
        <item name="trackColorActive">@color/accent_blue</item>
        <item name="trackColorInactive">@color/surface_divider</item>
        <item name="haloColor">@color/accent_blue</item>
        <item name="labelStyle">@style/LedSliderLabel</item>
    </style>

    <style name="LedSliderLabel" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/background_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger_red</item>
        <item name="materialButtonStyle">@style/LedButton</item>
        <item name="sliderStyle">@style/LedSlider</item>
    </style>

    <style name="AppTheme.Landscape" parent="AppTheme">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>